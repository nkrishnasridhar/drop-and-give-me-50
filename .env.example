# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; .env.example is committed as documentation.

# Neon Postgres connection string (pooled connection recommended).
# Create a project at https://neon.tech, then copy the connection string
# from the dashboard. Used by both the app (src/lib/env.ts) and
# drizzle-kit (drizzle.config.ts).
DATABASE_URL=

# Auth.js session/cookie signing secret. Generate one with:
#   npx auth secret
# (or any long random string). Use a different value per environment.
AUTH_SECRET=

# Web Push (Phase 5). Generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the Vercel Cron route GET /api/cron/reminders.
# Vercel sends Authorization: Bearer $CRON_SECRET automatically when set.
CRON_SECRET=

# Google OAuth 2.0 client, from https://console.cloud.google.com/apis/credentials
# ("Web application" type). Authorized redirect URI must be exactly:
#   <your-origin>/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google for local dev.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
